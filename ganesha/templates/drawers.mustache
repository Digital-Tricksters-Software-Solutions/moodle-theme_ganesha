{{!
    Ganesha Drawers Mustache Template.
}}
{{> theme_boost/head }}

<body {{{ bodyattributes }}}>

{{{ output.standard_top_of_body_html }}}

<div id="page-wrapper">

    <!-- 1. Playful Navigation Header -->
    <nav class="navbar navbar-expand fixed-top">
        <div class="container-fluid">
            <!-- Brand name linking back home -->
            <a href="{{{ config.wwwroot }}}" class="navbar-brand">
                <span>Ganesha!</span>
            </a>
            
            <div class="ml-auto d-flex align-items-center gap-3">
                <!-- Playful Accessibility Sensory Toggle -->
                <button class="btn btn-adventure-secondary sensory-toggle-btn mr-3">
                    ✨ Sensory Cozy Mode
                </button>
                
                <!-- user menu -->
                <div class="d-flex align-items-center">
                    {{{ output.user_menu }}}
                </div>
            </div>
        </div>
    </nav>

    <!-- Main Content wrapper containing collapsing drawers and activity area -->
    <div class="container-fluid" style="margin-top: 100px; padding-bottom: 50px;">
        
        <!-- Interactive Progress Path at the top of the course -->
        <div class="ganesha-progress-container mb-4">
            <div class="progress-track-label">
                <span>🦁 Ganesha's Quest Progress:</span>
                <span>Ready to Excel!</span>
            </div>
            <div class="progress">
                <div class="progress-bar" role="progressbar" style="width: 75%;" aria-valuenow="75" aria-valuemin="0" aria-valuemax="100"></div>
            </div>
        </div>

        <div class="row">
            <!-- Collapsible Left Navigation (looks like binder index tabs) -->
            <div class="col-lg-3 mb-4">
                <div class="cartoon-card p-3 h-100" style="background-color: #ffffff;">
                    <h5 class="mb-3" style="font-family:'Fredoka'; font-weight:700; color: #ff7e36;">🗺️ Quest Directory</h5>
                    <div class="ganesha-nav-tabs">
                        {{{ output.navigation_drawer }}}
                    </div>
                </div>
            </div>

            <!-- Central Content Area -->
            <div class="col-lg-6 mb-4">
                <div class="cartoon-card p-4" style="background-color: #ffffff; min-height: 500px;">
                    <!-- Breadcrumbs styled like stepping stones -->
                    <div class="ganesha-breadcrumbs mb-3">
                        {{{ output.navbar }}}
                    </div>

                    <!-- Moodle alerts & announcements -->
                    {{{ output.course_content_header }}}

                    <!-- Main Core Course Content -->
                    <div class="ganesha-internal-content">
                        {{{ output.main_content }}}
                    </div>

                    {{{ output.course_content_footer }}}
                </div>
            </div>

            <!-- Right Sidebar Blocks (styled like cozy blackboard/bulletin board) -->
            <div class="col-lg-3">
                <div class="cartoon-card p-3" style="background-color: #fffdf9;">
                    <h5 class="mb-3 text-center" style="font-family:'Fredoka'; font-weight:700; color: #4bb3fd;">🎒 My Pencil Box</h5>
                    <div class="ganesha-sidebar-blocks">
                        {{{ output.blocks_side_pre }}}
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Cute Footer -->
    <footer class="text-center py-4 mt-5" style="background-color: #fff8eb; border-top: 4px solid #332d27;">
        <p class="mb-1" style="font-weight: 700; color: #554e45;">
            🐘 theme Ganesha - K-12 learning adventures!
        </p>
        <p class="text-muted small mb-0">
            {{{ footertext }}}
        </p>
    </footer>
</div>

{{{ output.standard_end_of_body_html }}}

</body>
</html>
