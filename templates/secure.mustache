{{!
    Ganesha secure layout template.

    @package    theme_ganesha
    @copyright  2026 Ganesha Theme
    @license    http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later

    @template theme_ganesha/secure

    Example context (json):
    {
        "bodyattributes": "class=\"flat\"",
        "output": {
            "standard_top_of_body_html": "",
            "main_content": "<h1>Hello World</h1>",
            "user_menu": "<div>User Menu</div>",
            "standard_end_of_body_html": ""
        },
        "config": {
            "wwwroot": "http://localhost"
        },
        "isadmin": true
    }
}}
{{> theme_boost/head }}

<body {{{ bodyattributes }}}>

{{{ output.standard_top_of_body_html }}}

<div id="page-wrapper">
    <nav class="navbar navbar-expand fixed-top">
        <div class="container-fluid justify-content-center">
            <span class="navbar-brand">
                🔐 <span>{{#str}} securezone, theme_ganesha {{/str}}</span>
            </span>
        </div>
    </nav>

    <div class="container" style="margin-top: 100px; padding-bottom: 50px;">
        <div class="row justify-content-center">
            <div class="col-md-10 col-lg-8">
                <div class="cartoon-card p-5" style="background-color: #ffffff; border-color: #ff758f !important; box-shadow: 4px 4px 0px #ff758f !important;">
                    <div class="text-center mb-4">
                        <span style="font-size: 3rem;">🌟</span>
                        <h3 style="font-family: 'Fredoka'; font-weight:700; color: #ff758f;">{{#str}} yougotthis, theme_ganesha {{/str}}</h3>
                        <p class="text-muted">{{#str}} cheering, theme_ganesha {{/str}}</p>
                    </div>
                    {{{ output.main_content }}}
                </div>
            </div>
        </div>
    </div>
</div>

{{{ output.standard_end_of_body_html }}}

</body>
</html>
